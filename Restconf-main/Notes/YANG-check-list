============= PATH ================
ietf-interfaces
    interfaces
        interface [GigabitEthernet0/0/0]
            name = "GigabitEthernet0/0/0"
            description = "Connected --> HostBK"
            enabled = true

            ipv4                                    ietf-ip
                address
                    ip = "192.168.11.1"
                    prefix-length / netmask = 26


ietf-routing
    routing
        control-plane-protocols
            control-plane-protocol
                type
                name

                static-routes                       ietf-routing
                    ipv4
                        route
                            destination-prefix = "0.0.0.0/0"
                            next-hop
                                next-hop-address = "192.168.11.70"

                ospf                                ietf-ospf
                    areas
                        area [0]
                            area-id = 0

                            interfaces
                                interface [GigabitEthernet0/0/0]
                                    name = "GigabitEthernet0/0/0"
                                    enabled = true

                                    authentication
                                        ospfv2-key = "cisco"


ietf-access-control-list
    acls
        acl [BLOCK_TELNET]
            name = "BLOCK_TELNET"
            type

            aces
                ace [DENY_TELNET]
                    name = "DENY_TELNET"

                    matches
                        ipv4
                            source-ipv4-network = "192.168.11.10/32"

                        tcp
                            destination-port
                                operator
                                port = 23

                    actions
                        forwarding = DROP

                ace [PERMIT_ALL]
                    name = "PERMIT_ALL"

                    actions
                        forwarding = ACCEPT

    attachment-points
        interface [Serial0/1/0]
            interface-id = "Serial0/1/0"

            ingress
                acl-sets
                    acl-set [BLOCK_TELNET]
                        name = "BLOCK_TELNET"


ietf-system
    system
        hostname = "OVERBY"

        authentication
            user [admin]
                name = "admin"
                password = "..."


ietf-netconf
    copy-config
        input
            target
                startup

            source
                running

